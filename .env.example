# PostgreSQL database the browser data syncs to.
DATABASE_URL=postgresql://user:password@host:5432/finn

# Shared password required to sign in and sync.
AUTH_PASSWORD=change-me
# Secret used to sign session cookies (e.g. `openssl rand -hex 32`).
# Must stay stable across restarts or existing sessions are invalidated.
AUTH_SECRET=replace-with-a-long-random-string

# Pluggy (Open Finance) credentials from your developer dashboard. Used by the
# "Sync banks" feature to pull transactions for the itemId(s) you register.
PLUGGY_CLIENT_ID=your-pluggy-client-id
PLUGGY_CLIENT_SECRET=your-pluggy-client-secret

# Account owner's document (CPF/CNPJ) and display name. When a synced transfer has the
# owner on both sides (payer and receiver), it's treated as a self-transfer: named after
# the owner and hidden from the dashboard. Leave blank to disable. Document is matched on
# digits only, so any formatting is fine.
OWNER_DOCUMENT=000.000.000-00
OWNER_NAME=Your Name
