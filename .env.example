# PostgreSQL database the browser data syncs to.
DATABASE_URL=postgresql://user:password@host:5432/finn

# Shared password required to sign in and sync.
AUTH_PASSWORD=change-me
# Secret used to sign session cookies (e.g. `openssl rand -hex 32`).
# Must stay stable across restarts or existing sessions are invalidated.
AUTH_SECRET=replace-with-a-long-random-string
